+"""Transfer the owner's IP Control token over SDB to AeroTizen's private store.
+
+Uses only the Python standard library and the bundled AeroTizen SDB client.
+No pairing, application installation, Home settings, or certificate changes.
+"""
+
+import argparse
+import http.client
+import io
+import ipaddress
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "cli/src"))
+from aerotizen.sdb import Sdb, SdbError  # noqa: E402
+
+
+class ResponseSocket:
+    def __init__(self, data):
+        self.data = data
+
+    def makefile(self, *args):
+        return io.BytesIO(self.data)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tv", required=True, type=ipaddress.IPv4Address)
+    parser.add_argument(
+        "--token-file", type=Path,
+        default=Path.home() / ".config/cleanframe-hdmi-diagnostics/ip-control-token.json",
+    )
+    parser.add_argument("--check", action="store_true", help="read status without transferring a token")
+    parser.add_argument("--disable", action="store_true", help="remove only the TV's HDMI 5 configuration")
+    args = parser.parse_args()
+    if args.check and args.disable:
+        parser.error("Choose --check or --disable")
+    host = str(args.tv)
+    if args.check:
+        method, path, body = "GET", "/inputs/hdmi5", b""
+    elif args.disable:
+        method, path, body = "POST", "/control/hdmi5", b'{"enabled":false}'
+    else:
+        token = json.loads(args.token_file.read_text())["AccessToken"]
+        if not isinstance(token, str) or not 1 <= len(token) <= 2048:
+            raise ValueError("Invalid token file")
+        method, path = "POST", "/control/hdmi5"
+        body = json.dumps({"schema": 1, "host": host, "token": token}).encode()
+    packet = (
+        f"{method} {path} HTTP/1.1\r\n"
+        "Host: 127.0.0.1:47790\r\n"
+        "Connection: close\r\n"
+        "Content-Type: application/json\r\n"
+        "X-AeroTizen-HDMI5: 1\r\n"
+        f"Content-Length: {len(body)}\r\n\r\n"
+    ).encode() + body
+    with Sdb(host, timeout=15).connect() as connection:
+        data = connection.tcp_request(47790, packet, timeout=12, max_output=32768)
+    response = http.client.HTTPResponse(ResponseSocket(data))
+    response.begin()
+    result = json.loads(response.read())
+    if (
+        response.status != 200
+        or not isinstance(result, dict)
+        or type(result.get("configured")) is not bool
+        or (not args.check and result["configured"] == args.disable)
+    ):
+        raise ValueError("HDMI 5 setup failed; open the updated AeroTizen app and check the service")
+    # Only emit explicitly public fields; never print token-bearing response bodies.
+    print("HDMI 5 configured:", result.get("configured") is True)
+    if args.check:
+        print("Input:", result.get("inputSource") or "unknown")
+        print("Read successful:", result.get("ok") is True)
+    else:
+        print("Return to AeroTizen Home to refresh Inputs. Home and signing settings unchanged.")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, KeyError, SdbError, http.client.HTTPException):
+        raise SystemExit(
+            "HDMI 5 setup did not complete. Check SDB, the local token file, and that the "
+            "updated AeroTizen service is running. No automatic retry was performed."
+        ) from None
