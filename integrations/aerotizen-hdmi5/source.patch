diff --git a/tests/browser/hdmi5.spec.cjs b/tests/browser/hdmi5.spec.cjs
new file mode 100644
index 0000000..72a8a79
--- /dev/null
+++ b/tests/browser/hdmi5.spec.cjs
@@ -0,0 +1,64 @@
+const { test, expect } = require("@playwright/test");
+
+test("HDMI 5 omitted by Tizen gets a PS5 tile, IP switching, and native viewer handoff", async ({ page }) => {
+  const selections = [];
+  await page.route("https://**/*", (route) => route.fulfill({ body: "{}" }));
+  await page.route("http://127.0.0.1:47790/**", (route) => {
+    const select = route.request().url().endsWith("/inputs/hdmi5/select");
+    if (select) selections.push(route.request().method());
+    return route.fulfill({
+      contentType: "application/json",
+      headers: { "Access-Control-Allow-Origin": "*" },
+      body: JSON.stringify({ configured: true, ok: true, inputSource: select ? "HDMI5" : "HDMI4" }),
+    });
+  });
+  await page.addInitScript(() => {
+    window.nativeSources = [];
+    window.viewerLaunches = [];
+    localStorage.setItem(
+      "aerotizen.settings.v1",
+      JSON.stringify({
+        home: ["test.app"],
+        showWeather: false,
+        hideDisconnectedHdmi: true,
+      }),
+    );
+    window.tizen = {
+      application: {
+        getAppsInfo: (done) => done([{ id: "test.app", name: "Test app", packageId: "1234567890" }]),
+        launchAppControl() {},
+        launch: (id) => window.viewerLaunches.push(id),
+      },
+      systeminfo: {
+        getPropertyValue(name, done, fail) {
+          if (name === "VIDEOSOURCE")
+            done({
+              connected: [{ type: "HDMI", number: 4, editName: "Tanix" }],
+              disconnected: [{ type: "HDMI", number: 1 }],
+            });
+          else fail?.();
+        },
+        addPropertyValueChangeListener() {
+          return 1;
+        },
+      },
+      tvwindow: {
+        getSource() {
+          throw new Error("Unknown source type");
+        },
+        setSource(source) {
+          window.nativeSources.push(source);
+        },
+      },
+    };
+  });
+  await page.goto("/");
+  const ps5 = page.getByRole("button", { name: "PlayStation 5", exact: true });
+  await expect(ps5).toBeVisible();
+  await ps5.click();
+  await expect.poll(() => page.evaluate(() => window.viewerLaunches)).toEqual(["org.tizen.tv-viewer"]);
+  expect(selections).toEqual(["POST"]);
+  expect(await page.evaluate(() => window.nativeSources)).toEqual([]);
+  await page.evaluate(() => window.AeroTizen.inputs.load());
+  await expect(ps5).toHaveCount(1);
+});
